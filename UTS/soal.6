import cv2
import numpy as np
import matplotlib.pyplot as plt

# ======================================
# Membaca gambar
# ======================================
# Ganti "gambar.jpg" dengan nama file Anda
img = cv2.imread("camera.jpg")

# Cek apakah gambar berhasil dibaca
if img is None:
    print("Gambar tidak ditemukan!")
    exit()

# Konversi BGR ke RGB agar tampil benar di matplotlib
img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

# ======================================
# Menambahkan Salt-and-Pepper Noise
# ======================================
noise_img = img_rgb.copy()

# Jumlah noise
jumlah_noise = 5000

# Menambahkan titik putih (salt)
for i in range(jumlah_noise):
    y = np.random.randint(0, noise_img.shape[0])
    x = np.random.randint(0, noise_img.shape[1])
    noise_img[y, x] = [255, 255, 255]

# Menambahkan titik hitam (pepper)
for i in range(jumlah_noise):
    y = np.random.randint(0, noise_img.shape[0])
    x = np.random.randint(0, noise_img.shape[1])
    noise_img[y, x] = [0, 0, 0]

# ======================================
# a. Mean Filter (3x3)
# ======================================
mean_filter = cv2.blur(noise_img, (3,3))

# ======================================
# a. Median Filter (3x3)
# ======================================
median_filter = cv2.medianBlur(noise_img, 3)

# ======================================
# b. Menampilkan hasil
# ======================================
plt.figure(figsize=(12,8))

# Citra asli
plt.subplot(2,2,1)
plt.imshow(img_rgb)
plt.title("Citra Asli")
plt.axis("off")

# Citra noise
plt.subplot(2,2,2)
plt.imshow(noise_img)
plt.title("Salt-and-Pepper Noise")
plt.axis("off")

# Mean Filter
plt.subplot(2,2,3)
plt.imshow(mean_filter)
plt.title("Mean Filter 3x3")
plt.axis("off")

# Median Filter
plt.subplot(2,2,4)
plt.imshow(median_filter)
plt.title("Median Filter 3x3")
plt.axis("off")

plt.tight_layout()
plt.show()