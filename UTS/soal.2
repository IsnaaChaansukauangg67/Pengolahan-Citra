import cv2
import numpy as np
import matplotlib.pyplot as plt

# =========================
# Membaca gambar berwarna
# =========================
# Ganti "foto.jpg" dengan nama file gambar Anda
img_bgr = cv2.imread("maltoz.jpg")

# Cek apakah gambar berhasil dibaca
if img_bgr is None:
    print("Gambar tidak ditemukan!")
    exit()

# OpenCV membaca gambar dalam format BGR
# Konversi ke RGB agar warna tampil benar di matplotlib
img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)

# =========================
# Konversi ke grayscale
# =========================
img_gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY)

# =========================
# Konversi ke biner
# =========================
# Threshold 127
_, img_binary = cv2.threshold(img_gray, 127, 255, cv2.THRESH_BINARY)

# =========================
# Menampilkan ukuran array
# =========================
print("Ukuran array RGB      :", img_rgb.shape)
print("Ukuran array Grayscale:", img_gray.shape)
print("Ukuran array Biner    :", img_binary.shape)

# =========================
# Menghitung kebutuhan memori
# =========================
print("\nKebutuhan Memori:")
print("RGB       :", img_rgb.nbytes, "bytes")
print("Grayscale :", img_gray.nbytes, "bytes")
print("Biner     :", img_binary.nbytes, "bytes")

# =========================
# Menampilkan gambar
# =========================
plt.figure(figsize=(12,4))

# RGB
plt.subplot(1,3,1)
plt.imshow(img_rgb)
plt.title("RGB")
plt.axis("off")

# Grayscale
plt.subplot(1,3,2)
plt.imshow(img_gray, cmap='gray')
plt.title("Grayscale")
plt.axis("off")

# Biner
plt.subplot(1,3,3)
plt.imshow(img_binary, cmap='gray')
plt.title("Biner")
plt.axis("off")

plt.tight_layout()
plt.show()